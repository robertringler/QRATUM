/**
 * gradient_update.comp — GPU Gradient Update Compute Shader (GLSL 460)
 *
 * Performs the projected gradient descent step on the GPU:
 *
 *   ρ_{t+1} = Π_C(ρ_t − η ∇L(ρ_t))
 *
 * where ∇L is the combined gradient from constraints, observers, and entropy:
 *
 *   ∇L = Σ 2λ_i C_i(ρ) K_i  +  Σ 2μ_j (⟨O_j⟩ − y_j) O_j  −  γ(log ρ + I)
 *
 * This shader computes:
 *   1. Constraint gradient: Σ 2λ_i · val_i · K_i[d,e]
 *   2. Observer gradient: Σ 2μ_j · res_j · O_j[d,e]
 *   3. Combined gradient step: ρ[d,e] -= η * grad[d,e]
 *   4. Symmetrisation: ρ ← (ρ + ρ^T) / 2
 *   5. Eigenvalue clipping (positivity) — done in a separate pass or CPU
 *
 * Buffer layout:
 *   binding 0: density matrices ρ — float[B * D * D] (read-write)
 *   binding 1: constraint kernels — float[N_c * D * D]
 *   binding 2: observer matrices  — float[N_o * D * D]
 *   binding 3: constraint values  — float[B * N_c] (from contraction shader)
 *   binding 4: observer residuals — float[B * N_o]
 *   binding 5: parameters         — { B, D, N_c, N_o, lr, γ, ... }
 *   binding 6: weights            — float[N_c + N_o] (λ_i then μ_j)
 */
#version 460

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ---- Storage buffers ----
layout(std430, binding = 0) buffer DensityBuffer {
    float rho[];
};

layout(std430, binding = 1) readonly buffer ConstraintKernels {
    float K[];
};

layout(std430, binding = 2) readonly buffer ObserverMatrices {
    float O[];
};

layout(std430, binding = 3) readonly buffer ConstraintValues {
    float c_vals[];  // c_vals[b * N_c + i]
};

layout(std430, binding = 4) readonly buffer ObserverResiduals {
    float o_res[];  // o_res[b * N_o + j]
};

layout(std430, binding = 5) readonly buffer Params {
    uint  batch_size;
    uint  dim;
    uint  n_constraints;
    uint  n_observers;
    float learning_rate;
    float entropy_weight;
    float _pad1;
    float _pad2;
};

layout(std430, binding = 6) readonly buffer Weights {
    float weights[];  // weights[0..N_c-1] = λ_i, weights[N_c..N_c+N_o-1] = μ_j
};

void main() {
    uint global_id = gl_GlobalInvocationID.x;

    // Map global_id → (b, d, e) for ρ[b, d, e]
    uint D2 = dim * dim;
    uint total = batch_size * D2;
    if (global_id >= total) return;

    uint b  = global_id / D2;
    uint de = global_id % D2;
    uint d  = de / dim;
    uint e  = de % dim;

    // ---- Compute gradient at (b, d, e) ----
    float grad = 0.0;

    // 1. Constraint gradient: Σ 2λ_i C_i(ρ_b) K_i[d,e]
    for (uint i = 0; i < n_constraints; ++i) {
        float c_val   = c_vals[b * n_constraints + i];
        float lambda_i = weights[i];
        float K_de    = K[i * D2 + de];
        grad += 2.0 * lambda_i * c_val * K_de;
    }

    // 2. Observer gradient: Σ 2μ_j residual_j O_j[d,e]
    for (uint j = 0; j < n_observers; ++j) {
        float res_j  = o_res[b * n_observers + j];
        float mu_j   = weights[n_constraints + j];
        float O_de   = O[j * D2 + de];
        grad += 2.0 * mu_j * res_j * O_de;
    }

    // 3. Entropy gradient: −γ(log(ρ_ii) + 1) for diagonal, −γ for off-diagonal
    // Simplified: for a quick GPU approximation, use −γ * sign(ρ[d,e])
    // Full entropy gradient requires eigendecomposition (done on CPU/separate pass).
    // Here we use the first-order approximation: −γ · I (identity regulariser).
    if (d == e) {
        grad -= entropy_weight;
    }

    // ---- Gradient step ----
    uint rho_idx = b * D2 + de;
    float rho_val = rho[rho_idx];
    rho_val -= learning_rate * grad;

    // ---- Symmetrisation: ensure ρ[d,e] = ρ[e,d] ----
    // We write the average of (d,e) and (e,d) positions.
    uint mirror_idx = b * D2 + e * dim + d;
    float mirror_val = rho[mirror_idx] - learning_rate * grad; // Approximate mirror gradient
    float symmetric = 0.5 * (rho_val + mirror_val);

    rho[rho_idx] = symmetric;
    // Note: the mirror element is updated by its own thread.
}
